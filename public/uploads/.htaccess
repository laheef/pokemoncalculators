# =================================================================
# Pokémon Calculator Hub - Uploads Security Barrier
# Strictly block PHP and script execution in user upload directory
# =================================================================

# 1. Disable PHP execution engine in this folder
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# 2. Remove script handlers
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .sh
SetHandler default-handler

# 3. Deny direct access to executable and dangerous extensions
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|py|sh|asp|aspx|jsp|exe|bin|bat|cmd|dll)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Disable Directory Browsing
Options -Indexes -ExecCGI
